image boot.vfat {
	vfat {
		files = {
#BOOT_FILES#
		}
	}
	size = 32M
}

image data.ext4 {
  ext4 {
    label = "data"
  }
  srcpath = "${BOARD_DIR}/datafs-overlay"
  size = 10M
  # size = 100M
}

image kbrd.img {
	hdimage {
	}

	partition boot {
		partition-type = 0xC
		bootable = "true"
		image = "boot.vfat"
		size = 64M
		# size = 128M
	}

	partition rootfs {
		partition-type = 0x83
		image = "rootfs.ext4"
		size = 400M
		# A coller sur le menuconfig
	}

  	partition data {
    	partition-type = 0x83
    	image = "data.ext4"
    	size = 10M
		# size = 100M
		# A coller sur le image.data
	}	
}