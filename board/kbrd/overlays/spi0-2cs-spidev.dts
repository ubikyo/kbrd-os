/dts-v1/;
/plugin/;

&spi0 {
    status = "okay";

    spidev0: spidev@0 {
        compatible = "spidev";
        reg = <0>;
        spi-max-frequency = <32000000>;
        status = "okay";
    };

    spidev1: spidev@1 {
        compatible = "spidev";
        reg = <1>;
        spi-max-frequency = <32000000>;
        status = "okay";
    };
};