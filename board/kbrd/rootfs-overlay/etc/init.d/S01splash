#!/bin/sh
case "$1" in
  start)
    # -a : quitte automatiquement après l'affichage
    # -f : plein écran
    # -c : centré
    # &  : lance en arrière-plan pour ne pas bloquer le boot
    FRAMEBUFFER=/dev/fb1 fbv -a -f -c /etc/kbrd.png > /dev/null 2>&1 &
    ;;
  stop)
    killall fbv 2>/dev/null
    ;;
  *)
    echo "Usage: $0 {start|stop}"
    exit 1
    ;;
esac
exit 0