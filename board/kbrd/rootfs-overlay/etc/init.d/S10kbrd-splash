#!/bin/sh

FBV="/usr/bin/fbv"
IMAGE="/usr/share/kbrd/private/kbrd.png"
PIDFILE="/var/run/kbrd-splash.pid"

case "$1" in
    start)
        echo "Starting KBRD splash"

        "$FBV" -f -i -o 2 -y "$IMAGE" </dev/null >/dev/null 2>&1 &
        echo $! > "$PIDFILE"
        ;;

    stop)
        if [ -f "$PIDFILE" ]; then
            PID="$(cat "$PIDFILE")"

            if kill -0 "$PID" 2>/dev/null; then
                kill "$PID" 2>/dev/null
                wait "$PID" 2>/dev/null
            fi

            rm -f "$PIDFILE"
        fi
        ;;

    restart)
        "$0" stop
        "$0" start
        ;;

    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac